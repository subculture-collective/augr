{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "model": "openai/gpt-6-sol",
  "small_model": "openai/gpt-6-luna",
  "default_agent": "augr-completion",
  "permission": {
    "*": "deny"
  },
  "agent": {
    "augr-completion": {
      "description": "Tool-free completion backend for Augr model requests",
      "mode": "primary",
      "steps": 1,
      "permission": {
        "*": "deny"
      }
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "reasoning": true,
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "gpt-6-sol": {
          "name": "GPT-6 Sol",
          "reasoning": true,
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        }
      }
    }
  }
}
