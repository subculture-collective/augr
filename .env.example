# -----------------------------------------------------------------------------
# Augr environment template
# -----------------------------------------------------------------------------
# Copy to .env for local/NUC runs and fill secrets locally. Keep this file free
# of real credentials.

# -----------------------------------------------------------------------------
# Application / API
# -----------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
AUGR_API_PORT=3030
AUGR_WEB_PORT=3029
LOG_LEVEL=info
# JWT secret is required; the API server will not start if this is empty.
JWT_SECRET=
# Admin-only endpoints (kill-switch deactivation, POST /api/v1/risk/breaker/reset)
# require this X-Admin-Key value. When unset those endpoints return 503 and the
# service logs a startup WARN.
ADMIN_API_KEY=
# Unauthenticated API limits. API_RATE_LIMIT is requests per client per minute
# (0 disables). API_TRUSTED_PROXIES is a CSV of CIDRs whose X-Forwarded-For is
# honoured; leave empty when clients connect directly. API_CORS_ORIGINS is a
# CSV of allowed origins or "*".
API_RATE_LIMIT=100
API_TRUSTED_PROXIES=
API_CORS_ORIGINS=*
# Bounded wait for in-flight pipeline runs before shutdown cancels them.
SHUTDOWN_DRAIN_TIMEOUT=30s
# Required fixed v1 account for canonical reads and all operational writes.
# The account must be active and use paper_scored or paper_stress.
PROJECTION_ACCOUNT_ID=

# CLI/API clients
TRADINGAGENT_API_URL=http://127.0.0.1:8080
TRADINGAGENT_TOKEN=
TRADINGAGENT_API_KEY=

# -----------------------------------------------------------------------------
# Database / cache
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=tradingagent
DATABASE_URL=
# Production/NUC runtime URL for a non-owner, non-superuser application role.
# Never use the migration owner or projection-writer role here.
APP_DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_SSL_MODE=disable
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# LLM models and resilience
# -----------------------------------------------------------------------------
LLM_DEFAULT_PROVIDER=opencode
LLM_DEEP_THINK_MODEL=openai/gpt-6-sol
LLM_QUICK_THINK_MODEL=openai/gpt-6-luna
# Optional per-role overrides of the tier models: comma-separated role=model.
# risk_manager makes the final action, size, and stop call on every run.
# LLM_ROLE_MODELS=risk_manager=openai/gpt-6-astra
LLM_TIMEOUT=30s
# Per-call debate timeout before retrying with the quick model; empty or 0 disables.
LLM_DEBATE_TIMEOUT=
LLM_CACHE_ENABLED=
# Pipeline runs still "running" after this TTL are marked stale (default 50m; 0 disables).
STALE_RUN_TTL=

LLM_FALLBACK_PROVIDER=opencode
LLM_FALLBACK_MODEL=openai/gpt-5.6-terra
LLM_RETRY_MAX_ATTEMPTS=2
LLM_CALL_TIMEOUT=5m
LLM_BUDGET_REQUESTS_DAY=0
LLM_BUDGET_TOKENS_DAY=0
LLM_THROTTLE_CONCURRENCY=4

# Configure at least one API-backed provider, Ollama/llama-line, or the
# isolated OpenCode OAuth sidecar. OpenCode can use a ChatGPT account without
# exposing an OpenAI API key to Augr.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini
XAI_API_KEY=
XAI_BASE_URL=
XAI_MODEL=grok-3-mini

# llama-line bearer auth token for the Ollama-compatible broker.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenCode OAuth service. OPENCODE_MODEL must use provider/model form.
OPENCODE_BASE_URL=http://localhost:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_MODEL=openai/gpt-5.6-terra
# Host directory containing only OpenCode's auth.json; used by docker-compose.nuc.yml.
OPENCODE_AUTH_DIR=

# Embeddings default to OLLAMA_BASE_URL when EMBEDDING_BASE_URL is empty.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://10.0.0.50:11434
EMBEDDING_TIMEOUT=30s

# -----------------------------------------------------------------------------
# Market data providers
# -----------------------------------------------------------------------------
# Polygon REST API key for stock/options data provider chain.
POLYGON_API_KEY=
# Enables Polygon bulk snapshots used by the pre-market gap scanner. Requires plan entitlement.
POLYGON_BULK_SNAPSHOTS_ENABLED=false
POLYGON_FILES_ID=
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_RATE_LIMIT_PER_MINUTE=5
FINNHUB_API_KEY=
FINNHUB_RATE_LIMIT_PER_MINUTE=60
FMP_API_KEY=
FMP_RATE_LIMIT_PER_MINUTE=4
NEWSAPI_API_KEY=
# Bluesky post search requires a login. Create an app password under
# Settings > Privacy and security > App passwords. Without both values the
# Bluesky social provider is not registered.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
# BLUESKY_SERVICE_URL=https://bsky.social
TRADIER_API_KEY=
TRADIER_API_KEY_PROD=
TRADIER_ACCOUNT_NUMBER=
TRADIER_SANDBOX=true

# Polygon RPC/WS endpoints enable the optional Polymarket mempool signal source.
# Leave both blank to disable it.
POLYGON_RPC_URL=
POLYGON_WS_URL=

# -----------------------------------------------------------------------------
# Brokers / execution
# -----------------------------------------------------------------------------
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER_MODE=true

# Binance market data is public; these creds are for broker execution only.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_PAPER_MODE=true

# Paper evaluation identity. Only paper_scored may contribute promotion evidence.
# paper_stress is a separate synthetic namespace; multiplier 0 means unlimited
# for future stress-account implementations, never for paper_scored.
PAPER_EVALUATION_MODE=paper_scored
PAPER_INITIAL_CAPITAL=100000
PAPER_BUYING_POWER_MULTIPLIER=2
PAPER_SLIPPAGE_BPS=5
PAPER_FEE_PCT=0.0001

# Polymarket retail API credentials are required for live Polymarket trading.
# The app reads POLYMARKET_KEY_ID + POLYMARKET_SECRET_KEY. It does not read
# POLYMARKET_SECRET_ID; if your credential is labeled "secret", put that value
# in POLYMARKET_SECRET_KEY.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=
POLYMARKET_API_BASE_URL=https://api.polymarket.us
POLYMARKET_GATEWAY_BASE_URL=https://gateway.polymarket.us
POLYMARKET_CLOB_URL=https://clob.polymarket.com
# CLOB order-signing scheme: 0 EOA, 1 POLY_PROXY, 2 GNOSIS_SAFE. Stored only;
# the retail order payload does not carry it yet.
POLYMARKET_SIGNATURE_TYPE=0

# Kalshi host selection. With KALSHI_DEMO=true the default base URL is the demo
# exchange (its first catalog page is zero-volume markets). With
# KALSHI_DEMO=false the default is https://api.elections.kalshi.com/trade-api/v2.
# Leave KALSHI_API_BASE_URL empty to use the default for the chosen mode.
KALSHI_DEMO=true
KALSHI_API_BASE_URL=

# -----------------------------------------------------------------------------
# Polymarket market-data feed / recorder
# -----------------------------------------------------------------------------
# Feed is off by default. If POLYMARKET_WS_URL is blank, the app default is
# wss://ws-subscriptions-clob.polymarket.com/ws/.
POLYMARKET_WS_ENABLED=false

# Authenticated, read-only schema-60/61 account and immutable ledger inspection.
# This grants no account, capital-flow, or ledger write authority.
OVERHAUL_ACCOUNTS_READ_ENABLED=false
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/
POLYMARKET_WS_CONNECTIONS=100
POLYMARKET_WS_SLUGS=

# Recorder requires POLYMARKET_WS_ENABLED=true and schema 39+ TimescaleDB tables.
POLYMARKET_RECORDER_ENABLED=false

# -----------------------------------------------------------------------------
# Risk controls
# -----------------------------------------------------------------------------
RISK_MAX_POSITION_SIZE_PCT=0.10
RISK_MAX_DAILY_LOSS_PCT=0.02
RISK_MAX_DRAWDOWN_PCT=0.10
RISK_MAX_OPEN_POSITIONS=10
RISK_MAX_KALSHI_EXPOSURE_PCT=0.20
KALSHI_DRY_RUN=true
KALSHI_AUTO_EXITS_ENABLED=false
KALSHI_MARK_MAX_AGE=5m
# Configure all three to enable canonical Kalshi marking. The database URL must
# use the restricted projection-writer login, never the general app login.
KALSHI_PROJECTION_DATABASE_URL=
KALSHI_PROJECTION_KEY_ID=
KALSHI_PROJECTION_SECRET_B64=
RISK_CIRCUIT_BREAKER_THRESHOLD=0.05
RISK_CIRCUIT_BREAKER_COOLDOWN=15m
# Regime rules pause new allocations for a run when a threshold trips.
# Zero disables each rule. Win rate is a fraction (0-1).
REGIME_MAX_CONSECUTIVE_LOSSES=0
REGIME_MIN_ROLLING_WIN_RATE=0
TRADING_AGENT_KILL=

# Polymarket-specific risk limits.
RISK_POLYMARKET_MAX_SINGLE_EXPOSURE_PCT=0.05
RISK_POLYMARKET_MAX_TOTAL_EXPOSURE_PCT=0.30
RISK_POLYMARKET_MAX_POSITION_USDC=0
RISK_POLYMARKET_MIN_LIQUIDITY_USDC=1000
RISK_POLYMARKET_MAX_SPREAD_PCT=0.10
RISK_POLYMARKET_MIN_DAYS_TO_RESOLUTION=1

# -----------------------------------------------------------------------------
# Notifications / webhooks
# -----------------------------------------------------------------------------
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USERNAME=
NOTIFY_SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
NOTIFY_PAGERDUTY_WEBHOOK_URL=
NOTIFY_PAGERDUTY_WEBHOOK_SECRET=

# Canonical Discord webhook variables. Legacy DISCORD_* aliases still load in
# code for old deployments, but new env files should use NOTIFY_DISCORD_*.
NOTIFY_DISCORD_SIGNAL_WEBHOOK_URL=
NOTIFY_DISCORD_DECISION_WEBHOOK_URL=
NOTIFY_DISCORD_ALERT_WEBHOOK_URL=

# Alert routing
ALERT_PIPELINE_FAILURE_THRESHOLD=3
ALERT_PIPELINE_FAILURE_CHANNELS=telegram,email
ALERT_CIRCUIT_BREAKER_CHANNELS=telegram
ALERT_LLM_PROVIDER_DOWN_ERROR_RATE_THRESHOLD=0.5
ALERT_LLM_PROVIDER_DOWN_WINDOW=5m
ALERT_LLM_PROVIDER_DOWN_CHANNELS=telegram
ALERT_HIGH_LATENCY_THRESHOLD=120s
ALERT_HIGH_LATENCY_CHANNELS=email
ALERT_KILL_SWITCH_CHANNELS=telegram
ALERT_DB_CONNECTION_CHANNELS=email,pagerduty

# -----------------------------------------------------------------------------
# Feature flags / schedulers
# -----------------------------------------------------------------------------
ENABLE_SCHEDULER=false
SCHEDULER_JOB_TIMEOUT=45m
# How often the scheduler re-reads strategy schedules (0 disables; POST
# /api/v1/scheduler/reload forces one).
SCHEDULER_RELOAD_INTERVAL=60s
# First re-arm delay after an automation job auto-disables (empty = 1h default,
# doubling per repeat up to 24h).
AUTOMATION_AUTO_DISABLE_COOLDOWN=
# Run daily-or-slower automation jobs whose scheduled fire was missed while the
# process was down.
AUTOMATION_MISSED_RUN_CATCHUP=true
HISTORY_REFRESH_WATCHLIST_LIMIT=250
ENABLE_REDIS_CACHE=true
# Redis probe is advisory: /healthz reports redis=degraded but stays 200.
# Set REDIS_REQUIRED=true to fail /healthz (and restart the container) on a
# Redis outage.
REDIS_REQUIRED=false
# ENABLE_AGENT_MEMORY is deprecated and ignored; setting it logs a WARN.
ENABLE_LIVE_TRADING=false
# Portfolio allocator: shadow (default) records decisions without orders;
# paper submits paper orders and requires a paper_scored account with
# ENABLE_LIVE_TRADING=false.
PORTFOLIO_ALLOCATOR_MODE=shadow
# Promote shadow-qualified strategies automatically (default false).
AUTOMATIC_SHADOW_PROMOTION=false
# Operator attestation that the release-readiness recovery drills passed.
# Only affects the readiness report; never enables live trading.
RELEASE_DRILLS_VERIFIED=false
# Kalshi discovery screener tuning. FETCH_LIMIT pages past the demo host's
# zero-volume first page; the others are screener thresholds.
KALSHI_DISCOVERY_FETCH_LIMIT=500
KALSHI_DISCOVERY_MIN_VOLUME=1000
KALSHI_DISCOVERY_MIN_OPEN_INTEREST=500
KALSHI_DISCOVERY_MAX_SPREAD_PCT=12

ENABLE_TICKER_DISCOVERY=false
TICKER_DISCOVERY_CRON=30 10 * * 1-5
TICKER_DISCOVERY_MIN_ADV=100000
TICKER_DISCOVERY_MAX_TICKERS=30

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# Test/smoke helpers
# -----------------------------------------------------------------------------
DB_URL=
RUN_SMOKE_TEST=0
SMOKE_BASE_URL=http://127.0.0.1:8080
SMOKE_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tradingagent?sslmode=disable
SMOKE_JWT_SECRET=
# SEC EDGAR identity (required for 13F copy-source refreshes). Copy-trading
# refresh is disabled with a WARN when the email is empty.
SEC_EDGAR_APP_NAME=Augr
SEC_EDGAR_APP_EMAIL=
